# ─── Application ───────────────────────────────────────────────
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────
# SQLite for dev. Swap to postgresql+psycopg://user:pass@host/db in prod.
DATABASE_URL=sqlite:///./data/app.db

# ─── Vector store + embeddings ─────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
# Multilingual embedding model (~470MB, downloads on first run)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# ─── LLM provider ──────────────────────────────────────────────
# "auto" picks the first available among anthropic → openai → ollama → stub.
# Explicit values: anthropic | openai | ollama | stub
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ─── CORS ──────────────────────────────────────────────────────
# "*" allows any origin (dev default). In production, list explicit origins:
# CORS_ORIGINS=https://myapp.com,https://www.myapp.com
CORS_ORIGINS=*
# Must be false when CORS_ORIGINS=* (browser spec). Set true only with an explicit origin list.
CORS_ALLOW_CREDENTIALS=false
